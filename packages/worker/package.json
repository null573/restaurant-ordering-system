{
  "name": "@restaurant/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute restaurant-db --file=src/db/migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute restaurant-db --remote --file=src/db/migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "drizzle-orm": "^0.33.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "wrangler": "^3.78.0",
    "typescript": "^5.5.0"
  }
}
